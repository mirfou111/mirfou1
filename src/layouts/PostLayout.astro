---
import BaseLayout from './BaseLayout.astro';
import OriginBadge from '../components/OriginBadge.astro';
import StatusBadge from '../components/StatusBadge.astro';
import AntIcon from '../components/AntIcon.astro';
import { Calendar, Clock, Tag, ArrowLeft, CornerDownRight, CornerUpLeft, Sparkles, Network } from 'lucide-astro';
import { Image } from 'astro:assets';
import { readingTime } from '../utils/readingTime';
import { tagSlug } from '../utils/tags';
import { getGarden, resolve, suggestRelated, SECTION_META, REASON_LABEL } from '../utils/garden';
import type { Section } from '../utils/garden';

interface Props {
    title: string;
    description: string;
    pubDate: Date;
    updatedDate?: Date;
    tags?: string[];
    backHref: string;
    backLabel: string;
    origin?: 'authentique' | 'assiste' | 'genere';
    status?: 'graine' | 'pousse' | 'mature';
    /** Identifiant global du contenu courant, ex. "articles/mon-article" */
    currentRef: string;
    heroImage?: ImageMetadata;
    body?: string;
    headings?: { depth: number; slug: string; text: string }[];
}

const {
    title,
    description,
    pubDate,
    updatedDate,
    tags = [],
    backHref,
    backLabel,
    origin = 'authentique',
    status = 'mature',
    currentRef,
    heroImage,
    body,
    headings = [],
} = Astro.props;

const readTime = readingTime(body);
const tocItems = headings.filter(h => h.depth === 2 || h.depth === 3);

// ── Le jardin : liens sortants déclarés, rétroliens calculés, suggestions par tags
const garden = await getGarden();

const outgoing = resolve(garden, garden.outgoing.get(currentRef) ?? []);
const incoming = resolve(garden, garden.incoming.get(currentRef) ?? []);

// On complète par des suggestions tant que le contenu est peu relié
const suggestions = suggestRelated(
    garden,
    currentRef,
    Math.max(0, 3 - outgoing.length - incoming.length)
);

// Le libellé du bloc reflète la raison dominante des suggestions
const suggestionHint = suggestions.length > 0
    ? REASON_LABEL[suggestions[0].reason]
    : '';
---

<BaseLayout title={`${title} — mirfou`} description={description}>
    <div class="post-page">

        <a href={backHref} class="back-link">
            <ArrowLeft size={14} />
            <span>{backLabel}</span>
        </a>

        <div class={`post-layout ${tocItems.length > 0 ? 'has-toc' : ''}`}>

            <div class="post-main">

                {heroImage && (
                    <figure class="post-hero">
                        <Image
                            src={heroImage}
                            alt=""
                            widths={[420, 760, 1140]}
                            sizes="(max-width: 768px) 100vw, 68ch"
                            loading="eager"
                            fetchpriority="high"
                        />
                    </figure>
                )}

                <header class="post-header">
                    <h1 class="post-title">{title}</h1>
                    <p class="post-desc">{description}</p>

                    <div class="post-meta">
                        <span class="meta-item">
                            <Calendar size={13} />
                            <time>{pubDate.toLocaleDateString('fr-FR', { dateStyle: 'long' })}</time>
                        </span>
                        <span class="meta-item">
                            <Clock size={13} />
                            <span>{readTime}</span>
                        </span>
                        {updatedDate && (
                            <span class="meta-item">
                                <span>Mis à jour le</span>
                                <time>{updatedDate.toLocaleDateString('fr-FR', { dateStyle: 'long' })}</time>
                            </span>
                        )}
                        <OriginBadge origin={origin} linked />
                        <StatusBadge status={status} linked />
                    </div>

                    {tags.length > 0 && (
                        <div class="post-tags">
                            <Tag size={13} />
                            {tags.map(tag => (
                                <a href={`/tags/${tagSlug(tag)}`} class="tag">{tag}</a>
                            ))}
                        </div>
                    )}
                </header>

                <article class="post-content" data-pagefind-body>
                    <slot />
                </article>

                {(outgoing.length > 0 || incoming.length > 0 || suggestions.length > 0) && (
                    <div class="related">

                        {outgoing.length > 0 && (
                            <section class="related-block">
                                <p class="related-title">
                                    <CornerDownRight size={12} />
                                    <span>Dans le même jardin</span>
                                </p>
                                <ul class="related-list">
                                    {outgoing.map(item => (
                                        <li>
                                            <a href={item.href} class="related-item">
                                                <AntIcon size={11} class="related-ant" />
                                                <span
                                                    class="related-section"
                                                    style={`color: ${SECTION_META[item.section as Section].color}`}
                                                >{item.section}</span>
                                                <span class="related-name">{item.title}</span>
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            </section>
                        )}

                        {incoming.length > 0 && (
                            <section class="related-block">
                                <p class="related-title">
                                    <CornerUpLeft size={12} />
                                    <span>Mentionné dans</span>
                                    <span class="related-hint">rétroliens</span>
                                </p>
                                <ul class="related-list">
                                    {incoming.map(item => (
                                        <li>
                                            <a href={item.href} class="related-item">
                                                <AntIcon size={11} class="related-ant" />
                                                <span
                                                    class="related-section"
                                                    style={`color: ${SECTION_META[item.section as Section].color}`}
                                                >{item.section}</span>
                                                <span class="related-name">{item.title}</span>
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            </section>
                        )}

                        {suggestions.length > 0 && (
                            <section class="related-block">
                                <p class="related-title">
                                    <Sparkles size={12} />
                                    <span>À explorer</span>
                                    <span class="related-hint">{suggestionHint}</span>
                                </p>
                                <ul class="related-list">
                                    {suggestions.map(({ node, shared }) => (
                                        <li>
                                            <a href={node.href} class="related-item">
                                                <AntIcon size={11} class="related-ant" />
                                                <span
                                                    class="related-section"
                                                    style={`color: ${SECTION_META[node.section].color}`}
                                                >{node.section}</span>
                                                <span class="related-name">{node.title}</span>
                                                {shared.length > 0 && (
                                                    <span class="related-shared">{shared.join(' · ')}</span>
                                                )}
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            </section>
                        )}

                        <a href="/jardin" class="related-graph">
                            <Network size={12} />
                            <span>Voir le jardin en entier</span>
                        </a>
                    </div>
                )}

                <footer class="post-footer">
                    <div class="footer-ant">
                        <AntIcon size={16} />
                    </div>
                    <a href={backHref} class="back-link-bottom">
                        <ArrowLeft size={13} />
                        <span>Retour aux {backLabel}</span>
                    </a>
                </footer>

            </div>

            {tocItems.length > 0 && (
                <aside class="toc">
                    <p class="toc-title">Dans cet article</p>
                    <ul>
                        {tocItems.map(h => (
                            <li class={`depth-${h.depth}`}>
                                <a href={`#${h.slug}`}>{h.text}</a>
                            </li>
                        ))}
                    </ul>
                </aside>
            )}

        </div>
    </div>
</BaseLayout>

<style>
    .post-page {
        max-width: 1000px;
        margin: 0 auto;
        padding: 2.5rem 3rem 6rem;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        color: var(--color-muted);
        font-size: 0.82rem;
        margin-bottom: 2rem;
        transition: color 0.2s;
    }

    .back-link:hover { color: var(--color-accent); }

    /* Mesure de lecture constante : ~68 caractères, que l'article ait
       un sommaire ou non. Sans cette contrainte, un article sans titre h2
       s'étalait sur toute la largeur (~110 caractères par ligne). */
    .post-layout {
        display: grid;
        grid-template-columns: minmax(0, 68ch);
        justify-content: center;
    }

    .post-layout.has-toc {
        grid-template-columns: minmax(0, 68ch) 200px;
        gap: 4rem;
        align-items: start;
        justify-content: center;
    }

    .post-hero {
        margin: 0 0 2rem;
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid var(--color-border);
        background: var(--color-surface);
    }

    .post-hero :global(img) {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 16 / 9;
        object-fit: cover;
    }

    .post-header {
        margin-bottom: 3rem;
        padding-bottom: 2rem;
        border-bottom: 1px solid var(--color-border);
    }

    .post-title {
        font-size: clamp(1.6rem, 4vw, 2.4rem);
        font-weight: 700;
        color: var(--color-text);
        line-height: 1.2;
        margin-bottom: 0.75rem;
    }

    .post-desc {
        color: var(--color-muted);
        font-size: 1rem;
        line-height: 1.7;
        margin-bottom: 1.25rem;
    }

    .post-meta {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
        margin-bottom: 0.75rem;
    }

    .meta-item {
        display: flex;
        align-items: center;
        gap: 0.3rem;
        color: var(--color-muted);
        font-size: 0.78rem;
        font-family: var(--font-mono);
    }

    .post-tags {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        flex-wrap: wrap;
        color: var(--color-muted);
    }

    .tag {
        font-size: 0.72rem;
        font-family: var(--font-mono);
        color: var(--color-muted);
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        padding: 0.15rem 0.5rem;
        border-radius: 4px;
        transition: all 0.2s;
    }

    .tag:hover {
        color: var(--color-accent);
        border-color: var(--color-accent);
    }

    .post-content {
        font-size: 1rem;
        line-height: 1.85;
        color: var(--color-text);
    }

    .post-content :global(h2),
    .post-content :global(h3) {
        font-weight: 700;
        color: var(--color-text);
        margin: 2.5rem 0 1rem;
        line-height: 1.3;
    }

    .post-content :global(h2) { font-size: 1.4rem; }
    .post-content :global(h3) { font-size: 1.1rem; }
    .post-content :global(p) { margin-bottom: 1.5rem; }

    .post-content :global(a) {
        color: var(--color-accent);
        text-decoration: underline;
        text-underline-offset: 3px;
    }

    .post-content :global(blockquote) {
        border-left: 2px solid var(--color-accent);
        margin: 2rem 0;
        padding: 0.5rem 0 0.5rem 1.5rem;
        color: var(--color-muted);
        font-style: italic;
    }

    .post-content :global(code) {
        font-family: var(--font-mono);
        font-size: 0.85em;
        background: var(--color-surface);
        color: var(--color-accent);
        padding: 0.15rem 0.4rem;
        border-radius: 4px;
        border: 1px solid var(--color-border);
    }

    .post-content :global(pre) {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 8px;
        padding: 1.25rem;
        overflow-x: auto;
        margin: 1.5rem 0;
    }

    .post-content :global(pre code) {
        background: none;
        border: none;
        padding: 0;
        color: var(--color-text);
        font-size: 0.88rem;
    }

    .post-content :global(ul),
    .post-content :global(ol) {
        padding-left: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .post-content :global(li) { margin-bottom: 0.4rem; }

    .post-content :global(table) {
        width: 100%;
        border-collapse: collapse;
        margin: 1.5rem 0;
        font-size: 0.9rem;
    }

    .post-content :global(th),
    .post-content :global(td) {
        padding: 0.6rem 1rem;
        border: 1px solid var(--color-border);
        text-align: left;
    }

    .post-content :global(th) {
        background: var(--color-surface);
        color: var(--color-accent);
        font-weight: 600;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .post-content :global(hr) {
        border: none;
        border-top: 1px solid var(--color-border);
        margin: 2.5rem 0;
    }

    .post-content :global(img) {
        width: 100%;
        border-radius: 8px;
        margin: 2rem 0;
    }

    /* Related */
    .related {
        margin-top: 3rem;
        padding: 1.25rem;
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 8px;
    }

    .related-block + .related-block {
        margin-top: 1.25rem;
        padding-top: 1.25rem;
        border-top: 1px dashed var(--color-border);
    }

    .related-title {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.68rem;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--color-muted);
        font-weight: 600;
        margin-bottom: 0.75rem;
    }

    .related-title svg {
        color: var(--color-accent);
        flex-shrink: 0;
    }

    .related-hint {
        font-family: var(--font-mono);
        font-size: 0.6rem;
        letter-spacing: 0.05em;
        text-transform: none;
        font-weight: 400;
        color: var(--color-muted);
        opacity: 0.8;
        border: 1px solid var(--color-border);
        border-radius: 3px;
        padding: 0.05rem 0.35rem;
    }

    .related-list {
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .related-shared {
        font-family: var(--font-mono);
        font-size: 0.62rem;
        color: var(--color-muted);
        white-space: nowrap;
        flex-shrink: 0;
    }

    .related-graph {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        margin-top: 1.25rem;
        padding-top: 1rem;
        border-top: 1px dashed var(--color-border);
        width: 100%;
        font-size: 0.75rem;
        font-family: var(--font-mono);
        color: var(--color-muted);
        transition: color 0.2s;
    }

    .related-graph:hover { color: var(--color-accent); }

    .related-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.85rem;
        color: var(--color-text);
        transition: color 0.2s;
    }

    .related-item:hover { color: var(--color-accent); }

    .related-ant {
        color: var(--color-accent);
        flex-shrink: 0;
        opacity: 0.5;
        transition: opacity 0.2s;
    }

    .related-item:hover .related-ant { opacity: 1; }

    .related-section {
        font-family: var(--font-mono);
        font-size: 0.68rem;
        background: var(--color-surface-2);
        border: 1px solid var(--color-border);
        padding: 0.1rem 0.4rem;
        border-radius: 3px;
        flex-shrink: 0;
    }

    .related-name {
        flex: 1;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* Footer */
    .post-footer {
        margin-top: 4rem;
        padding-top: 2rem;
        border-top: 1px solid var(--color-border);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .footer-ant {
        color: var(--color-accent);
        opacity: 0.4;
    }

    .back-link-bottom {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        color: var(--color-muted);
        font-size: 0.82rem;
        transition: color 0.2s;
    }

    .back-link-bottom:hover { color: var(--color-accent); }

    /* TOC */
    .toc {
        position: sticky;
        top: 2rem;
    }

    .toc-title {
        font-size: 0.68rem;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--color-muted);
        font-weight: 600;
        margin-bottom: 0.75rem;
    }

    .toc ul {
        list-style: none;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }

    .toc a {
        font-size: 0.8rem;
        color: var(--color-muted);
        line-height: 1.4;
        transition: color 0.2s;
        display: block;
    }

    .toc a:hover { color: var(--color-accent); }

    .depth-3 { padding-left: 0.75rem; }
    .depth-3 a { font-size: 0.75rem; }

    /* Mobile */
    @media (max-width: 768px) {
        .post-page { padding: 2rem 1.5rem 4rem; }
        .post-layout,
        .post-layout.has-toc { grid-template-columns: minmax(0, 1fr); }
        .toc { display: none; }
    }
</style>