---
/**
 * Définit le glyphe fourmi une seule fois par page.
 * Les composants qui l'affichent en série (vignettes de cartes) le référencent
 * via <use href="#ant-glyph"> plutôt que de répéter le tracé complet.
 */
---

<svg width="0" height="0" aria-hidden="true" focusable="false" style="position:absolute">
    <symbol id="ant-glyph" viewBox="0 0 80 80">
        <circle cx="40" cy="18" r="8" fill="currentColor"/>
        <rect x="35" y="29" width="10" height="10" rx="1" transform="rotate(45 40 34)" fill="currentColor"/>
        <ellipse cx="40" cy="56" rx="11" ry="14" fill="currentColor"/>
        <line x1="35" y1="12" x2="26" y2="3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        <line x1="45" y1="12" x2="54" y2="3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        <circle cx="25" cy="2" r="2.5" fill="currentColor"/>
        <circle cx="55" cy="2" r="2.5" fill="currentColor"/>
        <path d="M36 31 L20 22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        <path d="M36 34 L18 34" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        <path d="M36 37 L20 46" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        <path d="M44 31 L60 22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        <path d="M44 34 L62 34" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        <path d="M44 37 L60 46" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
    </symbol>
</svg>
