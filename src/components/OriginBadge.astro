---
import { ORIGINS, anchor, type Origin } from '../utils/badges';

interface Props {
    origin: Origin;
    /** Rend le badge cliquable vers la légende. À laisser à false dans un lien parent. */
    linked?: boolean;
}

const { origin, linked = false } = Astro.props;
const { label, symbol, short, tone } = ORIGINS[origin];

const Tag = linked ? 'a' : 'span';
const attrs: Record<string, string> = linked
    ? { href: anchor('origine', origin), title: `${short} — voir la légende` }
    : { title: short };

const style = tone
    ? `color: ${tone}; border-color: color-mix(in srgb, ${tone} 25%, transparent); background: color-mix(in srgb, ${tone} 8%, transparent)`
    : '';
---

<Tag class:list={['badge', { neutral: !tone, linked }]} style={style} {...attrs}>
    <span class="badge-symbol">{symbol}</span>
    <span class="badge-label">{label}</span>
</Tag>

<style>
    .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.2rem 0.6rem;
        border-radius: 4px;
        font-size: 0.72rem;
        font-family: var(--font-mono);
        border: 1px solid;
        cursor: help;
        transition: opacity 0.2s;
    }

    .badge.neutral {
        color: var(--color-muted);
        border-color: var(--color-border);
        background: var(--color-surface);
    }

    .badge:hover { opacity: 0.8; }

    .badge.linked {
        cursor: pointer;
        text-decoration: none;
    }

    .badge.linked:hover {
        opacity: 1;
        border-color: currentColor;
    }

    .badge-symbol { font-size: 0.65rem; }
</style>
