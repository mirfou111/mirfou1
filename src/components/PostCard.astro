---
import OriginBadge from "./OriginBadge.astro";
import StatusBadge from "./StatusBadge.astro";
import PostThumb from "./PostThumb.astro";
import { Calendar, Clock } from "lucide-astro";
import { readingTime } from "../utils/readingTime";
import type { Origin, Status } from "../utils/badges";
import { SECTION_META, type Section } from "../utils/garden";

interface Props {
    title: string;
    description: string;
    pubDate: Date;
    href: string;
    tags?: string[];
    origin?: Origin;
    status?: Status;
    section: Section;
    heroImage?: ImageMetadata;
    body?: string;
    accentColor?: string;
    /** Affiche la section dans la carte - utile dans une liste toutes sections confondues */
    showSection?: boolean;
    /** "row" : ligne avec vignette carrée (listes) · "tile" : tuile verticale (grilles) */
    variant?: "row" | "tile";
}

const {
    title,
    description,
    pubDate,
    href,
    tags = [],
    origin = "authentique",
    status = "mature",
    section,
    heroImage,
    body,
    accentColor = "var(--color-accent)",
    showSection = false,
    variant = "row",
} = Astro.props;

const readTime = readingTime(body);
const tile = variant === "tile";
---

<a href={href} class:list={["card", { tile }]}>
    <PostThumb
        heroImage={heroImage}
        title={title}
        section={section}
        size={72}
        wide={tile}
        class="card-thumb"
    />

    <div class="card-body">
        {
            tile && showSection && (
                <span class="tile-section" style={`color: ${accentColor}`}>
                    {SECTION_META[section].label}
                </span>
            )
        }
        <h2 class="card-title" style={`color: ${accentColor}`}>{title}</h2>
        <p class="card-desc">{description}</p>
        <div class="card-footer">
            <div class="card-meta">
                {
                    !tile && showSection && (
                        <span
                            class="meta-section"
                            style={`color: ${accentColor}`}
                        >
                            {SECTION_META[section].label}
                        </span>
                    )
                }
                <span class="meta-item">
                    <Calendar size={12} />
                    <time>{pubDate.toLocaleDateString("fr-FR")}</time>
                </span>
                <span class="meta-item">
                    <Clock size={12} />
                    <span>{readTime}</span>
                </span>
            </div>
            <div class="card-right">
                {!tile && tags.slice(0, 2).map((tag) => <span class="tag">{tag}</span>)}
                <OriginBadge origin={origin} />
                <StatusBadge status={status} />
            </div>
        </div>
    </div>
</a>

<style>
    .card {
        display: grid;
        /* La vignette s'adapte à la largeur disponible, sans point de rupture */
        grid-template-columns: clamp(52px, 14vw, 72px) 1fr;
        gap: 1rem;
        align-items: start;
        padding: 1.25rem 0;
        border-bottom: 1px solid var(--color-border);
        transition: all 0.2s;
        text-decoration: none;
    }

    .card:last-child {
        border-bottom: none;
    }

    .card:hover .card-title {
        text-decoration: underline;
        text-underline-offset: 3px;
    }

    .card-body {
        min-width: 0;
    }

    .card :global(.card-thumb) {
        width: 100%;
        height: auto;
        aspect-ratio: 1;
        transition:
            border-color 0.2s,
            opacity 0.2s;
    }

    .card:hover :global(.card-thumb) {
        border-color: var(--color-accent);
    }

    .card-title {
        font-size: 1rem;
        font-weight: 700;
        line-height: 1.3;
        margin: 0 0 0.4rem;
    }

    @media (max-width: 520px) {
        .card {
            gap: 0.75rem;
        }
    }

    .card-desc {
        font-size: 0.88rem;
        color: var(--color-muted);
        line-height: 1.6;
        margin-bottom: 0.75rem;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .card-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .card-meta {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .meta-section {
        font-size: 0.68rem;
        font-family: var(--font-mono);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-weight: 600;
    }

    .meta-item {
        display: flex;
        align-items: center;
        gap: 0.25rem;
        font-size: 0.72rem;
        color: var(--color-muted);
        font-family: var(--font-mono);
    }

    .card-right {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        flex-wrap: wrap;
    }

    /* ── Variante tuile (grilles) ─────────────── */
    .card.tile {
        display: flex;
        flex-direction: column;
        gap: 0;
        padding: 0;
        height: 100%;
        border: 1px solid var(--color-border);
        border-radius: 8px;
        background: var(--color-bg);
        overflow: hidden;
        transition: border-color 0.2s, transform 0.2s;
    }

    .card.tile:last-child {
        border-bottom: 1px solid var(--color-border);
    }

    .card.tile:hover {
        border-color: var(--color-accent);
        transform: translateY(-2px);
    }

    .card.tile :global(.card-thumb) {
        aspect-ratio: 16 / 9;
    }

    .card.tile .card-body {
        display: flex;
        flex-direction: column;
        flex: 1;
        padding: 1rem 1.1rem 1.1rem;
    }

    .tile-section {
        font-family: var(--font-mono);
        font-size: 0.65rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin-bottom: 0.45rem;
    }

    .card.tile .card-desc {
        -webkit-line-clamp: 3;
    }

    /* Le pied de carte se cale en bas : toutes les tuiles d'une ligne s'alignent */
    .card.tile .card-footer {
        margin-top: auto;
        flex-direction: column;
        align-items: flex-start;
        gap: 0.6rem;
    }

    @media (prefers-reduced-motion: reduce) {
        .card.tile:hover {
            transform: none;
        }
    }

    .tag {
        font-size: 0.68rem;
        font-family: var(--font-mono);
        color: var(--color-muted);
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        padding: 0.1rem 0.4rem;
        border-radius: 3px;
    }
</style>
