---
/**
 * Message d'attente d'une rubrique sans contenu publié.
 * Les phrases vivent dans src/data/bientot.ts.
 */
import { Sprout, Rss, ArrowRight } from 'lucide-astro';
import { BIENTOT, type Rubrique } from '../data/bientot';

interface Props {
    rubrique: Rubrique;
}

const { rubrique } = Astro.props;
const { phrase, detail } = BIENTOT[rubrique];
const surAccueil = rubrique === 'accueil';
---

<section class="bientot" aria-labelledby={`bientot-${rubrique}`}>
    <span class="bientot-icone" aria-hidden="true">
        <Sprout size={22} />
    </span>

    <p class="bientot-kicker">En préparation</p>
    <h2 class="bientot-phrase" id={`bientot-${rubrique}`}>{phrase}</h2>
    <p class="bientot-detail">{detail}</p>

    <div class="bientot-liens">
        <a href="/rss.xml" class="bientot-lien">
            <Rss size={13} />
            <span>Être prévenu par le flux RSS</span>
        </a>
        {!surAccueil && (
            <a href="/" class="bientot-lien">
                <span>Retour au jardin</span>
                <ArrowRight size={13} />
            </a>
        )}
    </div>
</section>

<style>
    .bientot {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        padding: 2.25rem 2rem;
        border: 1px dashed var(--color-border);
        border-radius: 10px;
        background: color-mix(in srgb, var(--color-surface) 55%, transparent);
    }

    .bientot-icone {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        margin-bottom: 1.25rem;
        color: var(--color-accent);
        background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    }

    .bientot-kicker {
        font-family: var(--font-mono);
        font-size: 0.66rem;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        color: var(--color-muted);
        margin-bottom: 0.6rem;
    }

    .bientot-phrase {
        font-family: var(--font-main);
        font-size: clamp(1.3rem, 2.6vw, 1.7rem);
        font-style: italic;
        font-weight: 600;
        line-height: 1.3;
        color: var(--color-text);
        max-width: 30ch;
        text-wrap: balance;
        margin-bottom: 0.7rem;
    }

    .bientot-detail {
        font-size: 0.95rem;
        line-height: 1.7;
        color: var(--color-muted);
        max-width: 52ch;
        margin-bottom: 1.5rem;
    }

    .bientot-liens {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.5rem;
    }

    .bientot-lien {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--color-muted);
        transition: color 0.2s;
    }

    .bientot-lien:hover {
        color: var(--color-accent);
    }

    @media (max-width: 560px) {
        .bientot {
            padding: 1.75rem 1.25rem;
        }
    }
</style>
