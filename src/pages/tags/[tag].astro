---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { Tag as TagIcon, ArrowLeft } from "lucide-astro";
import { groupTags } from "../../utils/tags";
import { getGarden, SECTION_META } from "../../utils/garden";

export async function getStaticPaths() {
    // Tous les contenus publiés, toutes sections (Labo compris), via le graphe du jardin
    const { nodes } = await getGarden();

    // Un slug par tag - fusionne les variantes de casse et d'accentuation
    const entries = groupTags(nodes.flatMap((n) => n.tags));

    return entries.map(({ slug, label }) => ({
        params: { tag: slug },
        props: {
            tag: label,
            // garden.nodes est déjà trié du plus récent au plus ancien
            posts: nodes.filter((n) => n.tagSlugs.includes(slug)),
        },
    }));
}

const { tag, posts } = Astro.props;
---

<BaseLayout
    title={`#${tag} - mirfou`}
    description={`Tous les contenus du jardin mirfou marqués « ${tag} ».`}
>
    <div class="page">
        <a href="/tags" class="back-link">
            <ArrowLeft size={14} />
            <span>Tous les tags</span>
        </a>

        <header class="page-header">
            <div class="page-title-group">
                <TagIcon size={18} color="var(--color-accent)" />
                <h1>{tag}</h1>
            </div>
            <p class="page-sub">
                {posts.length} contenu{posts.length > 1 ? "s" : ""}
            </p>
        </header>

        <div class="list">
            {
                posts.map((post) => (
                    <PostCard
                        title={post.title}
                        description={post.description}
                        pubDate={post.pubDate}
                        href={post.href}
                        tags={post.tags}
                        origin={post.origin}
                        status={post.status}
                        section={post.section}
                        heroImage={post.heroImage}
                        body={post.body}
                        accentColor={SECTION_META[post.section].color}
                        showSection
                    />
                ))
            }
        </div>
    </div>
</BaseLayout>

<style>
    .page {
        max-width: 680px;
        margin: 0 auto;
        padding: 2.5rem 3rem 6rem;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        color: var(--color-muted);
        font-size: 0.82rem;
        margin-bottom: 2rem;
        transition: color 0.2s;
    }

    .back-link:hover {
        color: var(--color-accent);
    }

    .page-header {
        margin-bottom: 2.5rem;
        padding-bottom: 1.5rem;
        border-bottom: 1px solid var(--color-border);
    }

    .page-title-group {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        margin-bottom: 0.5rem;
    }

    h1 {
        font-size: 1.8rem;
        font-weight: 700;
        color: var(--color-text);
        margin: 0;
    }

    .page-sub {
        color: var(--color-muted);
        font-size: 0.9rem;
        margin: 0;
        font-family: var(--font-mono);
    }

    @media (max-width: 640px) {
        .page {
            padding: 2rem 1.5rem 4rem;
        }
    }
</style>
