---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroProverbe from "../components/HeroProverbe.astro";
import Bientot from "../components/Bientot.astro";
import PostCard from "../components/PostCard.astro";
import OriginBadge from "../components/OriginBadge.astro";
import StatusBadge from "../components/StatusBadge.astro";
import {
    BookOpen,
    Scroll,
    Terminal,
    Brain,
    FlaskConical,
    ArrowRight,
    Compass,
    Network,
    KeyRound,
    Hourglass,
    Beaker,
} from "lucide-astro";
import { SITE_DESCRIPTION, FEATURED } from "../consts";
import {
    getGarden,
    getLinks,
    getOrphans,
    pick,
    SECTIONS,
    SECTION_META,
    type Section,
} from "../utils/garden";

const garden = await getGarden();
const jardinVide = garden.nodes.length === 0;

// « Par où commencer » - sélection à la main, validée au build
const featured = pick(garden, FEATURED, "FEATURED (consts.ts)");

// Chiffres du réseau
const links = getLinks(garden);
const orphans = getOrphans(garden, links);
const liensPoses = links.filter((l) => l.kind === "explicite").length;

// Compteur par section
const parSection = SECTIONS.map((s) => ({
    section: s,
    ...SECTION_META[s],
    href: `/${s}`,
    count: garden.nodes.filter((n) => n.section === s).length,
}));

const icones: Record<Section, any> = {
    articles: BookOpen,
    contes: Scroll,
    tutos: Terminal,
    reflexions: Brain,
    recherches: FlaskConical,
    labo: Beaker,
};
---

<BaseLayout
    title="mirfou - le jardin secret d'Ousmane Ndieguene"
    description={SITE_DESCRIPTION}
>
    <div class="home">
        <HeroProverbe />

        {jardinVide && (
            <div class="block">
                <Bientot rubrique="accueil" />
            </div>
        )}

        <!-- Par où commencer -->
        {
            featured.length > 0 && (
                <section class="block">
                    <div class="block-head">
                        <h2 class="block-title">
                            <Compass size={14} />
                            <span>Par où commencer</span>
                        </h2>
                        <p class="block-sub">
                            Six portes d'entrée, une par chemin du jardin.
                        </p>
                    </div>
                    <div class="tiles">
                        {featured.map((n) => (
                            <PostCard
                                title={n.title}
                                description={n.description}
                                pubDate={n.pubDate}
                                href={n.href}
                                tags={n.tags}
                                origin={n.origin}
                                status={n.status}
                                section={n.section}
                                heroImage={n.heroImage}
                                body={n.body}
                                accentColor={SECTION_META[n.section].color}
                                showSection
                                variant="tile"
                            />
                        ))}
                    </div>
                </section>
            )
        }

        <!-- Les conventions -->
        <section class="block conventions">
            <div class="block-head">
                <h2 class="block-title">
                    <KeyRound size={14} />
                    <span>Les conventions du jardin</span>
                </h2>
            </div>
            <p class="conv-text">
                Chaque texte affiche <strong>qui l'a écrit</strong> et
                <strong>à quel point il est fini</strong>. Tout n'est pas mûr
                ici, et tout n'est pas de ma main - autant le dire.
            </p>
            <div class="conv-badges">
                <OriginBadge origin="authentique" linked />
                <OriginBadge origin="assiste" linked />
                <OriginBadge origin="genere" linked />
                <span class="conv-sep"></span>
                <StatusBadge status="graine" linked />
                <StatusBadge status="pousse" linked />
                <StatusBadge status="mature" linked />
            </div>
            <a href="/legende" class="conv-link">
                <span>Lire la légende complète</span>
                <ArrowRight size={13} />
            </a>
        </section>

        {!jardinVide && (
        <section class="block">
            <div class="block-head">
                <h2 class="block-title">
                    <Network size={14} />
                    <span>Le jardin</span>
                </h2>
                <p class="block-sub">Ce qui relie les contenus entre eux.</p>
            </div>
            <a href="/jardin" class="garden-card">
                <div class="garden-stats">
                    <div class="gstat">
                        <span class="gstat-value">{garden.nodes.length}</span>
                        <span class="gstat-label">contenus</span>
                    </div>
                    <div class="gstat">
                        <span class="gstat-value">{liensPoses}</span>
                        <span class="gstat-label">liens posés</span>
                    </div>
                    <div class="gstat">
                        <span
                            class="gstat-value"
                            class:list={[{ warn: orphans.length > 0 }]}
                        >
                            {orphans.length}
                        </span>
                        <span class="gstat-label">orphelins</span>
                    </div>
                </div>
                <span class="garden-cta">
                    <span>Parcourir le réseau</span>
                    <ArrowRight size={13} />
                </span>
            </a>
        </section>
        )}

        <!-- Explorer -->
        <section class="block">
            <div class="block-head">
                <h2 class="block-title">
                    <BookOpen size={14} />
                    <span>Explorer</span>
                </h2>
            </div>
            <div class="sections-grid">
                {
                    parSection.map(
                        ({ section, label, href, cssVar, count }) => {
                            const Icon = icones[section];
                            return (
                                <a
                                    href={href}
                                    class="sec-card"
                                    style={`--sec: var(${cssVar})`}
                                >
                                    <Icon size={18} />
                                    <span class="sec-label">{label}</span>
                                    <span class="sec-count">{count > 0 ? count : "bientôt"}</span>
                                </a>
                            );
                        },
                    )
                }
            </div>
            <div class="quick-links">
                <a href="/tags">Tags</a>
                <a href="/recherche">Rechercher</a>
                <a href="/labo">Labo</a>
                <a href="/projets">Projets</a>
                <a href="/about">À propos</a>
            </div>
        </section>

        <!-- Memento Mori - encart vers la page dédiée -->
        <a href="/memento-mori" class="memento-teaser">
            <div class="mm-grid" aria-hidden="true">
                <span class="mm-past"></span>
            </div>
            <div class="mm-text">
                <span class="mm-title">
                    <Hourglass size={13} />
                    <span>Memento Mori</span>
                </span>
                <p>
                    Un humain vit en moyenne 72 ans - environ 3 744 semaines.
                    Combien t'en reste-t-il ?
                </p>
                <span class="mm-cta">
                    <span>Compter les tiennes</span>
                    <ArrowRight size={13} />
                </span>
            </div>
        </a>
    </div>
</BaseLayout>

<style>
    .home {
        max-width: 1040px;
        margin: 0 auto;
        padding: 3rem 3rem 6rem;
    }

    /* ── Blocs ────────────────────────────────── */
    .block {
        margin-bottom: 3.5rem;
    }

    .block-head {
        margin-bottom: 1rem;
    }

    .block-title {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--color-text);
        margin: 0 0 0.25rem;
    }

    .block-title :global(svg) {
        color: var(--color-accent);
        flex-shrink: 0;
    }

    .block-sub {
        font-size: 0.82rem;
        color: var(--color-muted);
        font-style: italic;
        margin: 0;
    }

    /* Grille des tuiles : 3 colonnes, puis 2, puis 1 selon la place réelle
       disponible (requête de conteneur : indépendante de la sidebar). */
    .block:has(.tiles) {
        container-type: inline-size;
    }

    .tiles {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 1rem;
    }

    @container (min-width: 520px) {
        .tiles {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @container (min-width: 820px) {
        .tiles {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    /* ── Conventions ──────────────────────────── */
    .conventions {
        background: var(--color-surface);
        border: 1px solid var(--color-border);
        border-radius: 8px;
        padding: 1.5rem;
    }

    .conv-text {
        font-size: 0.9rem;
        line-height: 1.75;
        color: var(--color-text);
        margin: 0 0 1rem;
    }

    .conv-badges {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        flex-wrap: wrap;
        margin-bottom: 1rem;
    }

    .conv-sep {
        width: 1px;
        height: 18px;
        background: var(--color-border);
        margin: 0 0.35rem;
    }

    .conv-link {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        font-size: 0.8rem;
        color: var(--color-muted);
        transition: color 0.2s;
    }

    .conv-link:hover {
        color: var(--color-accent);
    }

    /* ── Aperçu du jardin ─────────────────────── */
    .garden-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem;
        flex-wrap: wrap;
        padding: 1.25rem 1.5rem;
        border: 1px solid var(--color-border);
        border-radius: 8px;
        background: var(--color-surface);
        transition: border-color 0.2s;
    }

    .garden-card:hover {
        border-color: var(--color-accent);
    }

    .garden-stats {
        display: flex;
        gap: 2rem;
    }

    .gstat {
        display: flex;
        flex-direction: column;
        gap: 0.1rem;
    }

    .gstat-value {
        font-family: var(--font-mono);
        font-size: 1.3rem;
        color: var(--color-text);
        line-height: 1;
    }

    .gstat-value.warn {
        color: var(--color-accent);
    }

    .gstat-label {
        font-size: 0.68rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--color-muted);
    }

    .garden-cta {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        font-size: 0.8rem;
        color: var(--color-muted);
    }

    .garden-card:hover .garden-cta {
        color: var(--color-accent);
    }

    /* ── Explorer ─────────────────────────────── */
    .sections-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
        gap: 0.5rem;
        margin-bottom: 1rem;
    }

    .sec-card {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 0.9rem;
        border: 1px solid var(--color-border);
        border-radius: 8px;
        background: var(--color-surface);
        color: var(--sec);
        transition:
            border-color 0.2s,
            background 0.2s;
    }

    .sec-card:hover {
        border-color: var(--sec);
        background: color-mix(in srgb, var(--sec) 7%, transparent);
    }

    .sec-card :global(svg) {
        flex-shrink: 0;
    }

    .sec-label {
        flex: 1;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .sec-count {
        font-family: var(--font-mono);
        font-size: 0.72rem;
        color: var(--color-muted);
    }

    .quick-links {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .quick-links a {
        font-size: 0.8rem;
        color: var(--color-muted);
        transition: color 0.2s;
    }

    .quick-links a:hover {
        color: var(--color-accent);
    }

    /* ── Memento Mori (encart statique) ───────── */
    .memento-teaser {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 1.5rem;
        align-items: center;
        padding: 1.5rem;
        border: 1px solid var(--color-border);
        border-radius: 8px;
        background: var(--color-surface);
        transition: border-color 0.2s;
    }

    .memento-teaser:hover {
        border-color: var(--color-accent);
    }

    /* Grille décorative dessinée en dégradé plutôt qu'en 240 éléments DOM */
    .mm-grid {
        position: relative;
        width: 160px;
        height: 96px;
        flex-shrink: 0;
        background-image: radial-gradient(
            var(--color-border) 1.4px,
            transparent 1.5px
        );
        background-size: 8px 8px;
    }

    .mm-past {
        position: absolute;
        inset: 0 0 auto 0;
        height: 38%;
        background-image: radial-gradient(
            var(--color-accent) 1.4px,
            transparent 1.5px
        );
        background-size: 8px 8px;
        opacity: 0.55;
    }

    .mm-title {
        display: flex;
        align-items: center;
        gap: 0.4rem;
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: var(--color-text);
        margin-bottom: 0.5rem;
    }

    .mm-title :global(svg) {
        color: var(--color-accent);
    }

    .mm-text p {
        font-size: 0.85rem;
        line-height: 1.7;
        color: var(--color-muted);
        margin: 0 0 0.6rem;
    }

    .mm-cta {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        font-size: 0.8rem;
        color: var(--color-muted);
    }

    .memento-teaser:hover .mm-cta {
        color: var(--color-accent);
    }

    /* ── Mobile ───────────────────────────────── */
    @media (max-width: 640px) {
        .home {
            padding: 2rem 1.5rem 4rem;
        }
        .garden-stats {
            gap: 1.5rem;
        }
        .memento-teaser {
            grid-template-columns: 1fr;
            gap: 1.25rem;
        }
        .mm-grid {
            width: 100%;
            height: 72px;
        }
    }
</style>
